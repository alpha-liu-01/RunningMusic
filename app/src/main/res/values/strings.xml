    <!-- RunningMusic: tempo analysis -->
    <string name="tempo_analysis">Tempo analysis</string>
    <string name="tempo_analysis_desc">Work out the tempo of every track, so running mode has something to match your cadence against.</string>
    <string name="tempo_analysis_starting">Looking for tracks to analyse…</string>
    <string name="tempo_analysis_known">%1$d of %2$d tracks have a tempo</string>
    <string name="tempo_analysis_unknown">%d were analysed but could not be read</string>
    <string name="tempo_analysis_pending">%d have not been analysed yet</string>
    <string name="tempo_analysis_start">Analyse</string>
    <string name="tempo_analysis_cancel">Stop</string>
    <string name="tempo_analysis_redo">Analyse everything again</string>
    <string name="tempo_analysis_redo_desc">Discards the tempos this app worked out. Ones you typed in and ones read from tags are kept.</string>
    <string name="tempo_analysis_charging">Only while charging</string>
    <string name="tempo_analysis_charging_desc">Waits for the phone to be plugged in. Analysing a whole library is real work for a battery.</string>
    <string name="tempo_analysis_note">A tempo is stored only when two separate stretches of a track agree on it. Tracks that disagree with themselves are left without one rather than guessed at, because a wrong tempo plays a track at a wildly wrong speed.</string>

    <!-- RunningMusic: running mode -->
    <string name="running_mode">Running</string>
    <string name="running_mode_active">Running, run in progress</string>
    <string name="running_cadence">Target cadence</string>
    <string name="running_cadence_unit">spm</string>
    <string name="running_cadence_desc">Steps per minute. Tracks are sped up or slowed down so their beat lands under your feet, and one whose tempo is half your cadence needs no stretching at all.</string>
    <string name="running_length">Run length</string>
    <string name="running_length_unit">min</string>
    <string name="running_length_desc">How long you are running for. The app takes the closest-matching tracks until that is covered, so a longer run accepts more stretching.</string>
    <string name="running_coverage">%1$d of %2$d tracks fit this cadence</string>
    <string name="running_plan">%1$s of music, stretched by %2$s at most</string>
    <string name="running_coverage_none">No analysed track fits this cadence. Try moving it a few spm.</string>
    <string name="running_suggestion">%1$d spm suits your library better: %2$d tracks instead of %3$d</string>
    <string name="running_suggestion_apply">Use %d</string>
    <string name="running_start">Start run</string>
    <string name="running_stop">End run</string>
    <string name="running_shortfall">%s short of your run. It will simply end early.</string>
    <string name="running_now_playing">%1$.0f bpm, %2$s, playing at %3$s</string>
    <string name="running_unmatched">Tempo unknown, so this one plays as recorded.</string>
    <string name="running_past_your_limit">Stretched further than your limit to keep it near your cadence.</string>
    <string name="running_gait_half">one step every two beats</string>
    <string name="running_gait_single">one step per beat</string>
    <string name="running_gait_multi">%d steps per beat</string>
    <string name="running_stretch">Most a track may be stretched</string>
    <string name="running_stretch_faster">Speed up</string>
    <string name="running_stretch_slower">Slow down</string>
    <string name="running_stretch_value">%d%%</string>
    <string name="running_stretch_desc">How far a track\'s tempo may be moved to land on your cadence. Wider takes in more of your library; narrower keeps everything closer to how it was recorded. Speeding up adds energy, slowing down tends to drag, so the two are set separately.</string>
    <plurals name="running_remaining">
        <item quantity="one">%1$s left, %2$d track</item>
        <item quantity="other">%1$s left, %2$d tracks</item>
    </plurals>
    <plurals name="running_needs_analysis">
        <item quantity="one">%d track has no tempo yet. Analyse it in Settings to bring it into your runs.</item>
        <item quantity="other">%d tracks have no tempo yet. Analyse them in Settings to bring them into your runs.</item>
    </plurals>
    <string name="running_note">Speed changes at track boundaries, never inside one: switching between one and two steps per beat mid-song would double the speed under you.</string>

    <string name="running_tracking">Cadence source</string>
    <string name="running_tracking_manual">Slider</string>
    <string name="running_tracking_lock">Measure</string>
    <string name="running_tracking_continuous">Follow</string>
    <string name="running_tracking_manual_desc">The target is whatever you set above, for the whole run.</string>
    <string name="running_tracking_lock_desc">Runs the first minute at your slider setting while it measures your natural cadence, then matches it and holds it there.</string>
    <string name="running_tracking_continuous_desc">Measures your cadence, then keeps following it. Moves a few spm a minute rather than jumping, because music that chases you is music you keep chasing back, but a pace you hold for a minute is one it will come to.</string>
    <string name="running_tracking_permission">Reading your cadence needs permission to detect steps.</string>
    <string name="running_tracking_permission_grant">Allow step detection</string>
    <string name="running_tracking_no_sensor">This device has no step detector, so the target can only come from the slider.</string>
    <string name="running_tracking_refused">The step detector would not start. The target is staying where you set it.</string>
    <string name="running_tracking_nonwakeup">Using the non-wakeup step detector, which may miss steps once the screen is off.</string>
    <string name="running_tracking_counted">Counting steps with the step counter.</string>
    <string name="running_tracking_timed">No step counter on this phone, so cadence is timed from the detector.</string>
